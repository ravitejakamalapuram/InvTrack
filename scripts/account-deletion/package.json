{
  "name": "invtrack-account-deletion",
  "private": true,
  "type": "module",
  "description": "Daily account-data deletion job for InvTrack (plus its Firestore rules and job tests).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:emulator": "firebase emulators:exec --only firestore,auth --project demo-invtrack \"node --test --test-concurrency=1 test/*.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.0.0",
    "firebase-tools": "^14.0.0"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "google-auth-library": "10.9.1"
  }
}
